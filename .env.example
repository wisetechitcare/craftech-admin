# Base URL for the backend API.
# Leave as /api in development (Vite proxies /api -> BACKEND_URL, see vite.config.ts and .env.development).
# In production set this to the deployed API origin, e.g. https://api.craftech.com/api
VITE_API_URL=/api

# Backend origin the dev-server proxy forwards /api requests to (see vite.config.ts).
# Only read by `npm run dev`; not used in production builds. See .env.development.
BACKEND_URL=http://localhost:5000

# Origin of the public website, embedded as the live preview in the CMS screens.
# Leave blank to hide the preview panes, e.g. https://www.craftech.com
VITE_SITE_URL=http://localhost:3000

# Google Maps Platform browser key for the Business location picker. It ships to
# the browser, so restrict it in the Cloud console: HTTP referrers = the admin
# origin; APIs = Maps JavaScript API, Places API (New), Geocoding API.
# Leave blank to hide the map; the address fields still work.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Cloud console → Map Management). Draggable pins need one;
# Google's DEMO_MAP_ID is used when blank.
VITE_GOOGLE_MAPS_MAP_ID=
