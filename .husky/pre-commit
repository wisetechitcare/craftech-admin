#!/usr/bin/env sh

echo "🔍 Running pre-commit checks..."

# ─────────────────────────────────────────────────────────────────────────────
# 1. Lint-Staged
#    Prettier + ESLint + Import Sorting + Remove Unused Imports
#    Runs ONLY on staged files
# ─────────────────────────────────────────────────────────────────────────────

echo ""
echo "▶ Checking formatting, imports & linting on staged files..."

npx lint-staged

LINT_STAGED_EXIT=$?

if [ $LINT_STAGED_EXIT -ne 0 ]; then
    echo ""
    echo "❌ Lint-staged checks failed!"
    echo "   Fix formatting issues : npm run format"
    echo "   Fix linting issues    : npm run lint:fix"
    echo ""
    exit 1
fi

echo "✅ Formatting, imports & linting checks passed."

# ─────────────────────────────────────────────────────────────────────────────
# 2. TypeScript
#    Full Project Type Checking
# ─────────────────────────────────────────────────────────────────────────────

echo ""
echo "▶ Checking for TypeScript errors..."

npm run type-check

TSC_EXIT=$?

if [ $TSC_EXIT -ne 0 ]; then
    echo ""
    echo "❌ TypeScript type-check failed!"
    echo "   Fix the above errors before committing."
    echo ""
    exit 1
fi

echo "✅ TypeScript type-check passed."

# ─────────────────────────────────────────────────────────────────────────────
# 3. Production Build
#    Ensures project builds successfully
# ─────────────────────────────────────────────────────────────────────────────

echo ""
echo "▶ Running production build..."

npm run build

BUILD_EXIT=$?

if [ $BUILD_EXIT -ne 0 ]; then
    echo ""
    echo "❌ Production build failed!"
    echo "   Fix the above errors before committing."
    echo ""
    exit 1
fi

echo "✅ Production build passed."

echo ""
echo "🎉 All pre-commit checks passed. Committing..."